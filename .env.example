# Floor Supervisor configuration.
# Copy to .env and fill in the secrets. Never commit .env.
#
# Note: the Streamlit bind address/port (127.0.0.1:8003) and the URL base path
# (/floor-supervisor/) are configured in .streamlit/config.toml, not here.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=America/Bogota
DEVICE_ID=FLOOR_SUPERVISOR_TABLET_01
DUPLICATE_SCAN_WINDOW_SECONDS=2
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# PostgreSQL (arrise_vm_db)
#   floor_supervisor schema: read/write
#   hibob_etl schema:        read only
# Local development goes through the SSH tunnel on port 5433.
# Production on the VM uses DB_PORT=5432.
# ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=arrise_vm_db
DB_USER=floor_supervisor_app
DB_PASSWORD=<secret>
DB_SSLMODE=require
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# ------------------------------------------------------------------
# Card Resolver
# ------------------------------------------------------------------
CARD_RESOLVER_URL=https://<card-resolver-host>/card-resolver/api/v1/cards/resolve
CARD_RESOLVER_BEARER_TOKEN=<secret>
CARD_RESOLVER_TIMEOUT_SECONDS=5
